# ── LLM provider (optional). Leave LLM_PROVIDER=none and everything still works
#    with rule-based output. Set to "anthropic" or "openai" for AI-written narratives.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── App
APP_ENV=development
APP_PORT=8000
# Comma-separated origins allowed to call this API (your Next.js site)
CORS_ORIGINS=http://localhost:3000,https://uniaiverse.ai

# ── Feature flags: comma-separated service ids to enable (see app/core/registry.py)
ENABLED_SERVICES=readiness_audit,training,strategy,governance,automation,pricing,quest,bot,payments,demos,discovery,delivery,platform,site

# ── URLs (used in bot answers, payment callbacks)
PUBLIC_URL=http://localhost:8000
SITE_URL=https://uniaiverse.ai

# ── Admin: approve news, add questions, mark bank transfers paid. Long random string.
ADMIN_TOKEN=

# ── Payments (Razorpay). Leave empty = test mode (orders simulated, no card data ever touches this server).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
UPI_LIMIT_INR=2000
BANK_TRANSFER_DETAILS="Account name: uniAIverse | Account no: XXXXXXXX | IFSC: XXXX0000000 | Quote the payment reference in the remark"

# ── Control plane (v2.6). Entitlement mode: off | log | enforce. Start in `log`; switch to `enforce` once the website sends X-Tenant-Key.
ENTITLEMENTS_MODE=log
# Where tenant environments are generated (compose file, env, namespaces). Backed up nightly.
TENANTS_DIR=outputs/tenants

# v2.6.1 — classroom gateway. The provider console cap is set BY HAND in the provider dashboard (registries/providers.yaml); this is the platform-wide second lock.
# LLM_GLOBAL_CAP_INR is read from platform_settings (POST /api/platform/llm/global-cap); default from token_policy.yaml.

# v2.8 — newsletter delivery (leave empty for dry-run). Verify the domain uniaiverse.ai in Resend first.
RESEND_API_KEY=
