# ═══════════════════════════════════════════════════════════════════════════════
# UNIAIVERSE WEBSITE - ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and configure your environment variables
# NEVER commit .env.local to version control!

# ───────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION (XAMPP MySQL)
# ───────────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uniaiverse

# ───────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
# Base URL for the website (used for SEO, redirects, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API Base URL (if using separate backend)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ───────────────────────────────────────────────────────────────────────────────
# SIGN-IN (Better Auth: Google + GitHub OAuth, users stored in MongoDB)
# ───────────────────────────────────────────────────────────────────────────────
# MongoDB connection string (MongoDB Atlas or a local mongod). Server only.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=uniaiverse
# Set to false for a standalone local mongod (no replica set). Atlas supports transactions.
MONGODB_TRANSACTIONS=true
# Public URL of this website. The AI Services API checks sign-in tokens against it.
BETTER_AUTH_URL=http://localhost:3000
# Random secret, e.g. `openssl rand -base64 32`. Never commit the real value.
BETTER_AUTH_SECRET=
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application)
#   Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → New OAuth App
#   Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Services API (apps/api, FastAPI). Public URL, not a secret. AI provider keys live only in apps/api.
NEXT_PUBLIC_AI_SERVICES_API_URL=http://localhost:8000

# ───────────────────────────────────────────────────────────────────────────────
# ADMIN PANEL CONFIGURATION
# ───────────────────────────────────────────────────────────────────────────────
# Comma-separated emails allowed into /admin. They sign in with Google/GitHub (see SIGN-IN below);
# the check runs on the server for every /api/admin/* request. No admin passwords.
ADMIN_EMAILS=

# ───────────────────────────────────────────────────────────────────────────────
# CALENDLY INTEGRATION (Optional - for booking features)
# ───────────────────────────────────────────────────────────────────────────────
# Get your API key from: https://calendly.com/integrations/api_webhooks
CALENDLY_API_KEY=

# Your Calendly username or organization
CALENDLY_USER=

# ───────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION (Optional - for contact form notifications)
# ───────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@uniaiverse.com
SMTP_FROM_NAME=uniAiverse

# Email recipient for contact form submissions
CONTACT_EMAIL=info@uniaiverse.com

# ───────────────────────────────────────────────────────────────────────────────
# SECURITY & SESSION (Optional but recommended for production)
# ───────────────────────────────────────────────────────────────────────────────
# Generate using: openssl rand -base64 32
# SESSION_SECRET=

# ───────────────────────────────────────────────────────────────────────────────
# FILE UPLOAD (Optional - if implementing file uploads)
# ───────────────────────────────────────────────────────────────────────────────
# Maximum file upload size in MB
MAX_FILE_SIZE=10

# Upload directory path (relative to project root)
UPLOAD_DIR=public/uploads

# ───────────────────────────────────────────────────────────────────────────────
# ANALYTICS (Optional - for tracking)
# ───────────────────────────────────────────────────────────────────────────────
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=

# ───────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS (Optional - for enabling/disabling features)
# ───────────────────────────────────────────────────────────────────────────────
ENABLE_BLOG=true
ENABLE_TESTIMONIALS=true
ENABLE_CONTACT_FORM=true
ENABLE_CALENDLY_BOOKING=false

# ───────────────────────────────────────────────────────────────────────────────
# PRODUCTION SETTINGS (Only for production deployment)
# ───────────────────────────────────────────────────────────────────────────────
# Set to 'production' when deploying
NODE_ENV=development

# Disable source maps in production for security
# GENERATE_SOURCEMAP=false
