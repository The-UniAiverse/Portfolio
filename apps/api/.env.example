# ── LLM provider (optional). Leave LLM_PROVIDER=none and everything still works
#    with rule-based output. Set to "anthropic", "openai", "gemini" or "deepseek" for AI-written narratives.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6
# Gemini (key from https://aistudio.google.com/apikey) and DeepSeek (https://platform.deepseek.com),
# both via their OpenAI-compatible APIs. LLM_MODEL applies to anthropic/openai only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional second provider, used automatically when the primary one fails (e.g. LLM_PROVIDER=gemini,
# LLM_FALLBACK_PROVIDER=deepseek).
LLM_FALLBACK_PROVIDER=none

# ── App
APP_ENV=development
APP_PORT=8000
# Comma-separated origins allowed to call this API (your Next.js site)
CORS_ORIGINS=http://localhost:3000,https://uniaiverse.ai

# ── Feature flags: comma-separated service ids to enable (see app/core/registry.py)
ENABLED_SERVICES=readiness_audit,training,strategy,governance,automation,pricing,jobs

# ── Abuse protection
# Max POST requests per client IP per minute on /api/* (0 disables). Process-local.
RATE_LIMIT_PER_MINUTE=30
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ── Student Job Finder (app/services/jobs, vendor/ai-job-search)
# Path to the Bun binary if it is not on PATH (needed for the job search connector).
# BUN_BIN=/usr/local/bin/bun
# Point the connector at a self-hosted freehire instance (default https://freehire.me).
# FREEHIRE_API_URL=

# ── Sign-in for AI tools (app/core/auth.py). Tokens come from the website's Better Auth (apps/web).
# AUTH_REQUIRED=false turns enforcement off (local development only).
AUTH_REQUIRED=true
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# Both equal the website's BETTER_AUTH_URL.
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000
