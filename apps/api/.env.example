# ── LLM provider (optional). Leave LLM_PROVIDER=none and everything still works
#    with rule-based output. Set to "anthropic" or "openai" for AI-written narratives.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# ── App
APP_ENV=development
APP_PORT=8000
# Comma-separated origins allowed to call this API (your Next.js site)
CORS_ORIGINS=http://localhost:3000,https://uniaiverse.ai

# ── Feature flags: comma-separated service ids to enable (see app/core/registry.py)
ENABLED_SERVICES=readiness_audit,training,strategy,governance,automation,pricing
